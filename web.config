<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".usdz" />
      <mimeMap fileExtension=".usdz" mimeType="model/vnd.usdz+zip" />
    </staticContent>
  </system.webServer>
</configuration>
